# MediCore HIS — Environment Variables Template
# Copy to: apps/api/.env (NestJS), apps/ai/.env (FastAPI), apps/web/.env.local (Next.js)
# NEVER commit real secrets to git

# ─── apps/api/.env (NestJS backend) ─────────────────────────────────────────

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://his_admin:his_dev_pass@localhost:5432/his_db?schema=public"

# MongoDB (Mongoose)
MONGODB_URI="mongodb://his_admin:his_dev_pass@localhost:27017/his_clinical?authSource=admin"
MONGODB_DB_NAME="his_clinical"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (shared with FastAPI — use the SAME secret in both)
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_HEX_USE_openssl_rand_hex_32"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Internal service auth (NestJS ↔ FastAPI)
INTERNAL_SERVICE_KEY="REPLACE_WITH_RANDOM_KEY_FOR_AI_SERVICE"

# App
NODE_ENV="development"
PORT=3001
CORS_ORIGINS="http://localhost:3000"

# FastAPI AI service URL (called by NestJS for AI features)
AI_SERVICE_URL="http://localhost:8000"

# Cloudflare R2 (file storage — patient documents, PDFs)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="medicore-files"
R2_PUBLIC_URL="https://files.medicore.app"

# Twilio (SMS)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_FROM_NUMBER="+1..."
TWILIO_VERIFY_SERVICE_SID="VA..."   # for patient OTP

# SendGrid (email)
SENDGRID_API_KEY="SG...."
SENDGRID_FROM_EMAIL="noreply@medicore.app"
SENDGRID_FROM_NAME="MediCore HIS"

# Stripe (payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Sentry (error tracking)
SENTRY_DSN="https://...@sentry.io/..."

# ─── apps/ai/.env (FastAPI AI service) ──────────────────────────────────────

# JWT (SAME secret as NestJS)
JWT_SECRET="SAME_AS_NESTJS_JWT_SECRET"

# Internal service auth
INTERNAL_SERVICE_KEY="SAME_AS_NESTJS_INTERNAL_SERVICE_KEY"

# NestJS backend URL (AI service calls this for patient context)
NESTJS_API_URL="http://localhost:3001/api/v1"

# Redis (same instance, for rate limiting + triage state)
REDIS_URL="redis://localhost:6379"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_FALLBACK_MODEL="gpt-4o-mini"    # cheaper fallback for simple requests

# AI rate limiting
AI_RATE_LIMIT_PER_USER_PER_HOUR=20
AI_CACHE_TTL_SECONDS=3600              # cache identical prompts for 1h

# App
PORT=8000
ENVIRONMENT="development"

# ─── apps/web/.env.local (Next.js frontend) ──────────────────────────────────

NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_AI_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="MediCore"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe publishable key (safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── Production overrides (Railway / Vercel) ─────────────────────────────────
# These replace the dev values above in production environments

# PostgreSQL: Railway Postgres plugin URL (set automatically by Railway)
# DATABASE_URL="postgresql://..." (set by Railway)

# MongoDB: Atlas connection string
# MONGODB_URI="mongodb+srv://...@cluster.mongodb.net/his_clinical"

# Redis: Railway Redis plugin URL (set automatically by Railway)
# REDIS_URL="redis://..." (set by Railway)

# CORS in production
# CORS_ORIGINS="https://app.medicore.ma,https://medicore.ma"
