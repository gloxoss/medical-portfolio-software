# ════════════════════════════════════════════════════════════════════════════════
# MediCore HIS — Complete Environment Variable Reference
# All variables required to run the full system.
# Copy root .env.example to .env and fill in real values.
# ════════════════════════════════════════════════════════════════════════════════

# ─── Node Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development                     # development | test | production

# ─── API Server (apps/api) ─────────────────────────────────────────────────────
APP_PORT=3001                            # NestJS listens on this port
FRONTEND_URL=http://localhost:3000       # Used for CORS + email links
ALLOWED_ORIGINS=http://localhost:3000   # Comma-separated allowed CORS origins

# ─── Database — PostgreSQL 16 ──────────────────────────────────────────────────
# Connection string for Prisma. Format: postgresql://USER:PASS@HOST:PORT/DB
DATABASE_URL=postgresql://medicore:medicore@localhost:5432/medicore_dev

# ─── Database — MongoDB 7 ──────────────────────────────────────────────────────
# Connection string for Mongoose. authSource must be admin for Docker setup.
MONGODB_URI=mongodb://medicore:medicore@localhost:27017/medicore_dev?authSource=admin

# ─── Cache — Redis 7.2 ─────────────────────────────────────────────────────────
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL=redis://:medicore@localhost:6379

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Secret must be ≥32 chars in production. Use: openssl rand -base64 32
JWT_SECRET=change-me-in-production-must-be-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m               # Access token TTL (short-lived)
JWT_REFRESH_EXPIRES_IN=7d               # Refresh token TTL (stored as hash in PG)

# ─── Patient Portal OTP (Dev only) ─────────────────────────────────────────────
# Optional fixed 6-digit OTP for local testing.
# Applied in non-production environments.
DEV_OTP_CODE=123456

# ─── Next.js Public Variables (apps/web) ───────────────────────────────────────
# Prefix NEXT_PUBLIC_ = exposed to browser. Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_AI_URL=http://localhost:8000

# ─── AI Sidecar (apps/ai) ──────────────────────────────────────────────────────
AI_PORT=8000                            # FastAPI listens on this port
OPENAI_API_KEY=sk-...                   # Required in Phase 2 (Step 23)

# ─── File Storage — Cloudflare R2 ──────────────────────────────────────────────
# S3-compatible. Used for patient documents, lab PDFs, profile photos.
R2_ACCOUNT_ID=                          # From Cloudflare dashboard
R2_ACCESS_KEY_ID=                       # R2 API token key ID
R2_SECRET_ACCESS_KEY=                   # R2 API token secret
R2_BUCKET_NAME=medicore-dev             # Different bucket per environment
R2_PUBLIC_URL=                          # Public URL for served assets (CDN)

# ─── Email — SendGrid ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG....                 # From SendGrid dashboard
EMAIL_FROM=noreply@medicore.ma          # Must be verified sender in SendGrid

# ─── SMS — Twilio ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...               # From Twilio console
TWILIO_AUTH_TOKEN=                      # From Twilio console
TWILIO_PHONE_NUMBER=+1...              # Twilio number for outbound SMS

# ─── Telemedicine — Daily.co ───────────────────────────────────────────────────
# DAILY_API_KEY is required for real video room creation + meeting tokens.
# Without it, API falls back to mock URLs/tokens for local UI flow validation.
DAILY_API_KEY=
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_MOCK_ROOM_URL=https://demo.daily.co/hello

# Telemedicine billing defaults (MAD)
TELEMEDICINE_BASE_CHARGE_MAD=300
TELEMEDICINE_PER_MINUTE_CHARGE_MAD=0

# ─── Payments — Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...          # sk_test_ for dev, sk_live_ for prod
STRIPE_WEBHOOK_SECRET=whsec_...        # From Stripe webhook dashboard

# ─── Monitoring — Sentry ───────────────────────────────────────────────────────
SENTRY_DSN=                             # Backend DSN (NestJS)
NEXT_PUBLIC_SENTRY_DSN=                 # Frontend DSN (Next.js — exposed to browser)

# ─── Deployment Notes ──────────────────────────────────────────────────────────
# Web:  Vercel (auto from git push to main)
# API:  Railway — set all non-NEXT_PUBLIC vars as Railway env vars
# AI:   Railway — Python service, separate deployment
# DBs:  Railway plugins (PG + Redis) or managed cloud services
